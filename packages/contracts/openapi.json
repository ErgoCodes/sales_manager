{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Always 200 while the process is up; `status` is `error` when a dependency is down.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "API and database health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Mercado Mónaco API",
    "description": "Back-office and sync API. Errors always use the `ErrorResponse` schema.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stable machine-readable error code"
              },
              "message": {
                "type": "string",
                "maxLength": 500,
                "description": "Human-readable message"
              },
              "details": {
                "description": "Validation issues only; never stack traces, SQL or internal objects",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "db"
        ],
        "additionalProperties": false
      }
    }
  }
}
