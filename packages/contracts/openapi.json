{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Always 200 while the process is up; `status` is `error` when a dependency is down.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "API and database health",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Creates or reuses a device and starts a new session (refresh family). Every failure is the same 401. Rate limited per IP and per (IP, email).",
        "operationId": "login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access and refresh tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Returns a new access token and a new refresh token. Within 10 s of a rotation the old token only gets an access token; after that, reusing it revokes the whole session (401). Rate limited per IP.",
        "operationId": "refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Rotate a refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/password": {
      "post": {
        "description": "Requires the current password. Revokes every other device of the user and rotates the current session: use the returned tokens. Rate limited per IP and per (IP, user).",
        "operationId": "changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens for the current device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change the own password",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current user, tenant and effective permissions",
        "tags": [
          "auth"
        ]
      }
    },
    "/locations": {
      "get": {
        "operationId": "listLocations",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from a previous page",
            "schema": {
              "minLength": 1,
              "maxLength": 512,
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of locations, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedLocations_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Locations the caller can see (all of them with any tenant-wide permission)",
        "tags": [
          "locations"
        ]
      },
      "post": {
        "operationId": "createLocation",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLocationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new location",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a location (locations:manage)",
        "tags": [
          "locations"
        ]
      }
    },
    "/locations/{id}": {
      "patch": {
        "operationId": "updateLocation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated location",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Rename a location or change its code (locations:manage)",
        "tags": [
          "locations"
        ]
      }
    },
    "/locations/{id}/archive": {
      "post": {
        "operationId": "archiveLocation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/Uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The archived location",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location_Output"
                }
              }
            }
          },
          "default": {
            "description": "Error (see ErrorResponse.code)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Archive a location (locations:manage); idempotent",
        "tags": [
          "locations"
        ]
      }
    }
  },
  "info": {
    "title": "Mercado Mónaco API",
    "description": "Back-office and sync API. Errors always use the `ErrorResponse` schema.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token (EdDSA JWT, 10 min)"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stable machine-readable error code"
              },
              "message": {
                "type": "string",
                "maxLength": 500,
                "description": "Human-readable message"
              },
              "details": {
                "description": "Validation issues only; never stack traces, SQL or internal objects",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "db"
        ],
        "additionalProperties": false
      },
      "Email": {
        "type": "string",
        "maxLength": 254,
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "description": "Email address (unique across tenants)"
      },
      "Password": {
        "type": "string",
        "minLength": 12,
        "maxLength": 256,
        "description": "Password, 12 to 256 characters, no composition rules",
        "format": "password"
      },
      "Uuid": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          {
            "pattern": "^[0-9a-f-]+$"
          }
        ],
        "description": "UUIDv7 identifier, canonical lowercase form"
      },
      "DeviceInfo": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Human label, e.g. \"Chrome on Windows\""
          },
          "platform": {
            "$ref": "#/components/schemas/DevicePlatform"
          }
        },
        "required": [
          "label",
          "platform"
        ]
      },
      "DevicePlatform": {
        "type": "string",
        "enum": [
          "web",
          "android",
          "ios"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "password": {
            "$ref": "#/components/schemas/Password"
          },
          "deviceId": {
            "description": "Known device of the same user; reused only if not revoked, otherwise a new one is created",
            "$ref": "#/components/schemas/Uuid"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceInfo"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Uuid_Output": {
        "type": "string",
        "allOf": [
          {
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          {
            "pattern": "^[0-9a-f-]+$"
          }
        ],
        "description": "UUIDv7 identifier, canonical lowercase form"
      },
      "AuthTokens_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "refreshToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresIn": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "description": "Access token lifetime in seconds",
            "minimum": 0
          },
          "deviceId": {
            "$ref": "#/components/schemas/Uuid_Output"
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "deviceId",
          "mustChangePassword"
        ],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RefreshResponse_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "minLength": 1
          },
          "expiresIn": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "description": "Access token lifetime in seconds",
            "minimum": 0
          },
          "refreshToken": {
            "type": "string",
            "description": "Absent when served from the grace window",
            "minLength": 1
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ],
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "newPassword": {
            "$ref": "#/components/schemas/Password"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "Email_Output": {
        "type": "string",
        "maxLength": 254,
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "description": "Email address (unique across tenants)"
      },
      "PermissionGrant_Output": {
        "type": "object",
        "properties": {
          "permission": {
            "$ref": "#/components/schemas/Permission_Output"
          },
          "scope": {
            "$ref": "#/components/schemas/AssignmentScopeResponse_Output"
          }
        },
        "required": [
          "permission",
          "scope"
        ],
        "additionalProperties": false
      },
      "Permission_Output": {
        "type": "string",
        "enum": [
          "tenant:manage",
          "locations:manage",
          "users:manage",
          "roles:manage",
          "devices:manage",
          "audit:view",
          "catalog:write",
          "inventory:write",
          "inventory:transfer",
          "sales:create",
          "sales:void",
          "reports:view",
          "cash:close"
        ],
        "description": "Permission catalog entry"
      },
      "AssignmentScopeResponse_Output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "tenant"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "locations"
                ]
              },
              "locationIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Uuid_Output"
                }
              }
            },
            "required": [
              "type",
              "locationIds"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Tenant-wide, or limited to the listed locations"
      },
      "MeResponse_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid_Output"
              },
              "email": {
                "$ref": "#/components/schemas/Email_Output"
              },
              "displayName": {
                "type": "string"
              },
              "mustChangePassword": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "email",
              "displayName",
              "mustChangePassword"
            ],
            "additionalProperties": false
          },
          "tenant": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Uuid_Output"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "slug"
            ],
            "additionalProperties": false
          },
          "deviceId": {
            "$ref": "#/components/schemas/Uuid_Output"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionGrant_Output"
            },
            "description": "For hiding UI only; the API is the authority"
          }
        },
        "required": [
          "user",
          "tenant",
          "deviceId",
          "permissions"
        ],
        "additionalProperties": false
      },
      "Location_Output": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Uuid_Output"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "archivedAt": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IsoDateTime_Output"
              }
            ],
            "nullable": true
          },
          "createdAt": {
            "$ref": "#/components/schemas/IsoDateTime_Output"
          }
        },
        "required": [
          "id",
          "name",
          "code",
          "archivedAt",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "IsoDateTime_Output": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
        "description": "ISO 8601 UTC date-time"
      },
      "PaginatedLocations_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location_Output"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Null when there are no more pages",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "CreateLocationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "description": "Short code, unique per tenant"
          }
        },
        "required": [
          "name",
          "code"
        ]
      },
      "UpdateLocationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "description": "Short code, unique per tenant"
          }
        }
      }
    }
  }
}
