    "test:coverage": "vitest run --coverage"
  },
  "dependencies": { "date-fns": "^3.6.0" },
  "devDependencies": {
    "@monaco/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.25.0",
    "typescript": "~5.9.2",
    "vitest": "^5.1.0"
  }
}
