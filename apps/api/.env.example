# Copy to .env (gitignored) and adjust. Development values only.
NODE_ENV=development
PORT=4000
# Runtime connection: the API always connects as monaco_app (no superuser, no
# BYPASSRLS), so row-level security applies. Postgres from infra/docker-compose.yml.
DATABASE_URL=postgres://monaco_app:monaco_app@localhost:5432/monaco
# Migrations only (drizzle-kit: db:migrate, db:studio): the schema owner role.
# Never give this URL to the running API.
DATABASE_MIGRATION_URL=postgres://monaco_owner:monaco_owner@localhost:5432/monaco
# Comma-separated list of exact origins allowed by CORS. "*" is rejected.
CORS_ORIGINS=http://localhost:3000
# Optional: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=debug
