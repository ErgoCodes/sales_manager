# Copy to .env (gitignored) and adjust. Development values only.
NODE_ENV=development
PORT=4000
# Postgres from infra/docker-compose.yml (arrives in SP1 T4). Unused by the stub DB adapter.
DATABASE_URL=postgres://monaco_app:monaco_app@localhost:5432/monaco
# Comma-separated list of exact origins allowed by CORS. "*" is rejected.
CORS_ORIGINS=http://localhost:3000
# Optional: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=debug
