{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "ignore": [
          "**/__tests__/**",
          "**/*.test.ts"
        ]
      }
    },
    "typeCheck": false,
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json"
  }
}
