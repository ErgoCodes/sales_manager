{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prelint": "pnpm --filter @monaco/domain build",
    "lint": "expo lint",
    "pretest": "pnpm --filter @monaco/domain build",
    "test": "jest",
    "pretest:coverage": "pnpm --filter @monaco/domain build",
    "test:coverage": "jest --coverage",
    "pretypecheck": "pnpm --filter @monaco/domain build",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../../packages/contracts/openapi.json -o lib/api/schema.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.3.4",
    "@monaco/domain": "workspace:*",
    "@react-native-community/datetimepicker": "9.2.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.52.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.8.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.27.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/db/__tests__/helpers.ts",
      "<rootDir>/db/__tests__/test-db.ts",
      "<rootDir>/lib/session/__tests__/fake-api.ts"
    ],
    "collectCoverageFrom": [
      "db/**/*.ts",
      "lib/**/*.ts",
      "!db/client.ts",
      "!db/schema.ts",
      "!db/__tests__/**",
      "!lib/backup.ts",
      "!lib/excel.ts",
      "!lib/notifications.ts",
      "!lib/__tests__/**",
      "!lib/**/__tests__/**",
      "!lib/session/react.ts",
      "!lib/session/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 93,
        "branches": 69,
        "functions": 95,
        "lines": 95
      }
    }
  }
}
