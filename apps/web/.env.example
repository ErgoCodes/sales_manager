# Copy to .env.local (gitignored). Development values only.
# Server-side only: never prefix with NEXT_PUBLIC_.
# Base URL of apps/api (its PORT in apps/api/.env).
API_URL=http://localhost:4000
# Same value as CLIENT_IP_HMAC_SECRET in apps/api/.env (>= 32 chars; `pnpm --filter api keys:generate` prints one).
# Required in production. Signs the client-IP header the API trusts (ADR 0004).
CLIENT_IP_HMAC_SECRET=
# Comma-separated origins this app is served from. Allow-list for Server Actions and for
# the Origin check on mutating Route Handlers. Required in production.
APP_ORIGINS=http://localhost:3000
# How many trusted reverse proxies sit in front of this app (default 0 = trust no x-forwarded-for).
# The client IP is the x-forwarded-for entry this many positions from the RIGHT, so a client cannot
# forge it by prepending. With 0, rate limits in the API key on this server's own address.
TRUSTED_PROXY_HOPS=0
# Public demo only (SP4 · D10). With DEMO_MODE=true, /login lists DEMO_ACCOUNTS (JSON array of
# { "label", "email", "password" }) as buttons that fill the form. Server-side only; they are the
# published demo credentials, valid only in the read-only demo tenant. Leave unset elsewhere.
# DEMO_MODE=true
# DEMO_ACCOUNTS=[{"label":"Propietario","email":"owner@demo.example","password":"demo-owner-pass"},{"label":"Encargado","email":"manager@demo.example","password":"demo-manager-pass"},{"label":"Cajero","email":"cashier@demo.example","password":"demo-cashier-pass"}]
