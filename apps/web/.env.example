# Copy to .env.local (gitignored). Development values only.
# Server-side only: never prefix with NEXT_PUBLIC_.
# Base URL of apps/api (its PORT in apps/api/.env).
API_URL=http://localhost:4000
# Same value as CLIENT_IP_HMAC_SECRET in apps/api/.env (>= 32 chars; `pnpm --filter api keys:generate` prints one).
# Required in production. Signs the client-IP header the API trusts (ADR 0004).
CLIENT_IP_HMAC_SECRET=
# Comma-separated origins this app is served from. Allow-list for Server Actions and for
# the Origin check on mutating Route Handlers. Required in production.
APP_ORIGINS=http://localhost:3000
