{
  "name": "sales-manager",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "start": "pnpm --filter mobile start",
    "dev": "pnpm -r --parallel --filter api --filter web dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter api db:migrate",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "web": "pnpm --filter mobile web",
    "lint": "pnpm -r lint",
    "pretypecheck": "pnpm build",
    "typecheck": "pnpm -r typecheck",
    "pretest": "pnpm build",
    "test": "pnpm -r test",
    "pretest:coverage": "pnpm build",
    "test:coverage": "pnpm -r test:coverage",
    "prepare": "husky",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "openapi:generate": "pnpm --filter api openapi:generate"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
